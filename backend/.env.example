# Backend runtime
ENVIRONMENT=development

# Local development:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1|192\.168\.\d+\.\d+|172\.\d+\.\d+\.\d+):5173
DATABASE_PATH=./data/msalisia_phase0.db

# Production on Railway:
# ENVIRONMENT=production
# CORS_ORIGINS=https://your-vercel-frontend.vercel.app
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
# DATABASE_PATH=/app/data/msalisia_phase0.db

# Anthropic / Claude API
# If ANTHROPIC_API_KEY is set, Claude is used first.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Groq API
# Used as a fallback when ANTHROPIC_API_KEY is not set or Claude fails.
# Create/provide a Groq API key and keep it server-side only.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_TEMPERATURE=0.35
LLM_MAX_TOKENS=420
